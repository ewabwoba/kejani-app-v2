# =============================================================================
# kejani-platform — root .gitignore
# One file for the whole repo: kejani-app-v2 (Expo), nyumbaconnect-web (Vite),
# mock-api (Node), and the future Spring Boot backend.
# Patterns without a leading "/" match at any depth.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECRETS — highest priority, never commit these
# -----------------------------------------------------------------------------
# Environment files (keep the .env.example templates, ignore the real ones)
.env
.env.*
!.env.example
!.env.*.example
*.env.local
./../node_modules

# Signing keys and certificates
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.cer
keystore.properties
credentials.json

# Firebase / Google service config (contains project identifiers and keys)
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json
serviceAccount*.json
service-account*.json
.firebase/

# Spring Boot secrets and local overrides
application-local.properties
application-local.yml
application-secret*.properties
application-secret*.yml
application-dev.properties
application-dev.yml

# -----------------------------------------------------------------------------
# 2. DEPENDENCIES
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/

# NOTE: package-lock.json is deliberately NOT ignored — commit it so every
# machine installs identical versions. Pick ONE package manager per project;
# if you use npm, ignore the other managers' lockfiles to avoid conflicts:
yarn.lock
pnpm-lock.yaml
bun.lockb

# -----------------------------------------------------------------------------
# 3. BUILD OUTPUT
# -----------------------------------------------------------------------------
dist/
build/
out/
web-build/
.next/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# 4. EXPO / REACT NATIVE
# -----------------------------------------------------------------------------
.expo/
.expo-shared/
.metro-health-check*
.metro-cache/
.idea/
# Native folders generated by `npx expo prebuild` from app.json.
# Ignored because Expo regenerates them. REMOVE these two lines only if you
# start hand-editing native code (custom Gradle/Xcode changes) and need them
# tracked.
android/
ios/

# Native build artifacts
*.apk
*.aab
*.ipa
*.app
*.dSYM/
Pods/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
.gradle/
local.properties
.cxx/
*.hprof
captures/

# EAS (Expo Application Services) local build output
.eas/
eas-build-local*

# -----------------------------------------------------------------------------
# 5. SPRING BOOT / JAVA (backend, when it's added)
# Wrapper jars (gradle-wrapper.jar, maven-wrapper.jar) are intentionally NOT
# ignored — they must be committed so `./gradlew` / `./mvnw` work on a fresh clone.
# -----------------------------------------------------------------------------
target/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.log
*.war
*.ear
hs_err_pid*
replay_pid*
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# -----------------------------------------------------------------------------
# 6. TESTING / COVERAGE / LOGS
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
junit.xml
*.lcov
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 7. CACHES
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.turbo/
.npm/
.node_repl_history
*.tgz

# -----------------------------------------------------------------------------
# 8. OPERATING SYSTEM NOISE (Windows first, plus macOS/Linux for teammates)
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*
*~
.directory
.Trash-*

# -----------------------------------------------------------------------------
# 9. EDITORS / IDEs
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.history/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.fleet/
.vs/
*.suo
*.user

# -----------------------------------------------------------------------------
# 10. PROJECT-SPECIFIC
# -----------------------------------------------------------------------------
# Packaged deliverables and scratch files
*.zip
*.rar
*.7z
*.tar
*.tar.gz
tmp/
temp/
*.bak
*.orig
*.rej

# mock-api: any locally persisted data if you add a file-backed store later
mock-api/data/*.local.json
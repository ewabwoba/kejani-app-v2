# Expo inlines any EXPO_PUBLIC_*-prefixed variable into the JS bundle at
# build time (Metro reads it directly, no native module needed). Copy this
# file to .env and Metro picks it up automatically — restart `expo start`
# after changing it.
#
# NOTE: EXPO_PUBLIC_ vars are bundled into the app and are NOT secret —
# never put a real API secret key here, only public base URLs/IDs.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
